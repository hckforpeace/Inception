# domain name of the website
DOMAIN_NAME=pbeyloun.42.fr
# MYSQL SETUP

# database name
MYSQL_DB=wordpress 

# database user
MYSQL_USER=database_user

# database user password
MYSQL_PASSWORD=database_user_password 

# root password
MYSQL_ROOT_PASSWORD=root_password 

# WP SETUP

# admin name
WP_ADMIN_N=admin_name 

# admin password
WP_ADMIN_P=admin_password 

# website title
WP_TITLE=website_title 

# admin email
WP_ADMIN_E=admin_@email.com 

# WP NEW USER SETUP

# user name of the new user
WP_U_NAME=user_name

# user password
WP_U_PASS=user_password

# author, editor, Administrator ...
WP_U_ROLE=author

# user email
WP_U_EMAIL=user_@email.com 
